# Loaded automatically by `astro dev` only. Committed deliberately: it holds no
# secrets, and the whole point is that a fresh clone runs against a local
# backend without anyone having to be told to configure one.
#
# Note that these two alone do NOT switch analytics on. The host allowlist in
# src/scripts/analytics.ts keeps localhost silent regardless, which is what
# stops dev traffic reaching production. They describe where to report *if*
# reporting is enabled — to enable it, add to .env.local (not committed):
#
#     PUBLIC_ANALYTICS_FORCE=true
#
# and run the ingest service on :8080.

PUBLIC_ANALYTICS_BASE_URL=http://localhost:8080

# -dev suffix so that even a forced local run partitions away from real data.
PUBLIC_ANALYTICS_APP_NAME=abhilaksh-blog-dev
